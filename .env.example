LEAKPROOF_ENVIRONMENT=development
LEAKPROOF_DATABASE_URL=postgresql+psycopg://leakproof:leakproof@postgres:5432/leakproof
LEAKPROOF_REDIS_URL=redis://redis:6379/0
LEAKPROOF_DEFAULT_MERCHANT_ID=merchant_demo
LEAKPROOF_MODE=simulation

# Required only for LEAKPROOF_MODE=live_demo. Never put live Razorpay keys here.
LEAKPROOF_PUBLIC_BASE_URL=
LEAKPROOF_RECOVERY_TOKEN_SECRET=
LEAKPROOF_RAZORPAY_KEY_ID=
LEAKPROOF_RAZORPAY_KEY_SECRET=
LEAKPROOF_RAZORPAY_WEBHOOK_SECRET=
LEAKPROOF_OPENAI_API_KEY=
LEAKPROOF_OPENAI_MODEL=gpt-5.6-luna
# Used only to convert OpenAI USD token charges into the paise audit ledger.
LEAKPROOF_OPENAI_USD_TO_INR=100
LEAKPROOF_RESEND_API_KEY=
LEAKPROOF_RESEND_WEBHOOK_SECRET=
LEAKPROOF_RESEND_FROM_EMAIL=
LEAKPROOF_DEMO_EMAIL_ALLOWLIST=
LEAKPROOF_DEMO_AMOUNT_PAISE=50000
LEAKPROOF_DEMO_CURRENCY=INR
LEAKPROOF_DEMO_SESSION_TTL_MINUTES=30
LEAKPROOF_DEMO_SESSIONS_PER_IP_HOUR=10
LEAKPROOF_DEMO_CHECKOUT_EVENTS_PER_SESSION=100
LEAKPROOF_DEMO_ABANDONMENT_DELAY_SECONDS=30
# Release kill switches. Existing webhook reconciliation remains active.
LEAKPROOF_DEMO_SESSIONS_ENABLED=true
LEAKPROOF_LUNA_ENABLED=true
LEAKPROOF_OUTBOUND_EMAIL_ENABLED=true
LEAKPROOF_RESEND_DAILY_LIMIT=100
LEAKPROOF_RESEND_MONTHLY_LIMIT=3000

# Holdout and attribution rules are pre-declared in config/measurement.yaml.

# zrok credentials and its generated public URL do not belong in this file.
